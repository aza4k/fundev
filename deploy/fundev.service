[Unit]
Description=Gunicorn daemon for fundev.uz Django site
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fundev
ExecStart=/var/www/fundev/venv/bin/gunicorn \
    --access-logfile - \
    --error-logfile - \
    --workers 3 \
    --bind unix:/var/www/fundev/fundev.sock \
    studio.wsgi:application
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
